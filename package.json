{
  "name": "agentmat",
  "private": true,
  "version": "1.15.0",
  "description": "AgentMate: AI Agent Management Platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agentmat/core --filter @agentmat/protocol build && pnpm --parallel --filter @agentmat/core --filter @agentmat/protocol --filter @agentmat/desktop dev",
    "build": "pnpm --filter @agentmat/core --filter @agentmat/protocol build && pnpm --filter @agentmat/desktop build",
    "package": "pnpm --filter @agentmat/desktop package",
    "mobile": "pnpm --filter @agentmat/protocol build && pnpm --filter @agentmat/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0"
}
