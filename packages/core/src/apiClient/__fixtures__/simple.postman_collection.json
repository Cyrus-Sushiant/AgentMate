      "name": "List users",
      "protocolProfileBehavior": { "disableBodyPruning": true },
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/users?page=1",
          "host": ["{{baseUrl}}"],
          "path": ["users"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "debug", "value": "true", "disabled": true }
          ]
        }
      },
      "response": []
    },
    {
